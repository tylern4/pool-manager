{
  "title": "Pool Manager",
  "uid": "pool-manager",
  "tags": ["pool-manager", "htcondor", "hpc"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Current Status",
      "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "Idle Jobs",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1},
      "targets": [
        {
          "expr": "pool_manager_idle_jobs",
          "legendFormat": "idle",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 50},
              {"color": "red", "value": 200}
            ]
          },
          "unit": "short"
        }
      }
    },
    {
      "id": 3,
      "title": "Active Workers",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1},
      "targets": [
        {
          "expr": "pool_manager_active_workers",
          "legendFormat": "active",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 8},
              {"color": "red", "value": 12}
            ]
          },
          "unit": "short"
        }
      }
    },
    {
      "id": 4,
      "title": "Target Workers",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1},
      "targets": [
        {
          "expr": "pool_manager_target_workers",
          "legendFormat": "target",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 8},
              {"color": "red", "value": 12}
            ]
          },
          "unit": "short"
        }
      }
    },
    {
      "id": 5,
      "title": "Workers Started (total)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 1},
      "targets": [
        {
          "expr": "pool_manager_workers_started_total",
          "legendFormat": "started",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "blue"},
          "unit": "short"
        }
      }
    },
    {
      "id": 6,
      "title": "Workers Stopped (total)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 1},
      "targets": [
        {
          "expr": "pool_manager_workers_stopped_total",
          "legendFormat": "stopped",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "purple"},
          "unit": "short"
        }
      }
    },
    {
      "id": 7,
      "title": "Scale Events (total)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 1},
      "targets": [
        {
          "expr": "pool_manager_scale_up_events_total + pool_manager_scale_down_events_total",
          "legendFormat": "total",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "orange"},
          "unit": "short"
        }
      }
    },
    {
      "id": 8,
      "title": "Workers & Jobs Over Time",
      "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5}
    },
    {
      "id": 9,
      "title": "Idle Jobs & Workers",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "targets": [
        {
          "expr": "pool_manager_idle_jobs",
          "legendFormat": "Idle jobs",
          "refId": "A"
        },
        {
          "expr": "pool_manager_active_workers",
          "legendFormat": "Active workers",
          "refId": "B"
        },
        {
          "expr": "pool_manager_target_workers",
          "legendFormat": "Target workers",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "Worker States Breakdown",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "targets": [
        {
          "expr": "pool_manager_running_workers",
          "legendFormat": "Running",
          "refId": "A"
        },
        {
          "expr": "pool_manager_pending_workers",
          "legendFormat": "Pending",
          "refId": "B"
        },
        {
          "expr": "pool_manager_draining_workers",
          "legendFormat": "Draining",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "stackSeries": true
    },
    {
      "id": 11,
      "title": "Workers by Node Type",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "targets": [
        {
          "expr": "pool_manager_workers_by_node_type",
          "legendFormat": "{{node_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "stackSeries": true
    },
    {
      "id": 12,
      "title": "Tasks Placed by Node Type",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
      "targets": [
        {
          "expr": "pool_manager_tasks_by_node_type",
          "legendFormat": "{{node_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "stackSeries": true
    },
    {
      "id": 13,
      "title": "Events",
      "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 22}
    },
    {
      "id": 14,
      "title": "Scale Events",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 23},
      "targets": [
        {
          "expr": "rate(pool_manager_scale_up_events_total[$__rate_interval])",
          "legendFormat": "Scale up",
          "refId": "A"
        },
        {
          "expr": "rate(pool_manager_scale_down_events_total[$__rate_interval])",
          "legendFormat": "Scale down",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps"
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 15,
      "title": "Worker Start/Stop Rate",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 23},
      "targets": [
        {
          "expr": "rate(pool_manager_workers_started_total[$__rate_interval])",
          "legendFormat": "Started",
          "refId": "A"
        },
        {
          "expr": "rate(pool_manager_workers_stopped_total[$__rate_interval])",
          "legendFormat": "Stopped",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps"
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 16,
      "title": "Tick Duration (p50 / p90 / p99)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 23},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(pool_manager_tick_duration_seconds_bucket[$__rate_interval]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, rate(pool_manager_tick_duration_seconds_bucket[$__rate_interval]))",
          "legendFormat": "p90",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(pool_manager_tick_duration_seconds_bucket[$__rate_interval]))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
